[TEMPLATE]
DATABASE_URL=postgresql+asyncpg://soc_user:soc_password@localhost:5432/soc_db

# --- Wazuh (external VM/lab; never bundled with this app) --------------------
# WAZUH_MODE=mock keeps development working with explicitly-marked mock alerts.
# Set WAZUH_MODE=real plus the values below to consume a live Wazuh API.
WAZUH_MODE=mock
WAZUH_BASE_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_API_URL=
WAZUH_VERIFY_SSL=true

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Vector store / knowledge base (Phase 4A) -------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=security_knowledge

# Local directory holding out-of-band source data (NOT committed to Git):
#   enterprise-attack.json  (MITRE ATT&CK STIX bundle)
#   nvd_cves.json           (NVD CVE API 2.0 export)
KNOWLEDGE_DATA_DIR=knowledge

# "local-hashing" = deterministic offline default; swap later for a real
# embedding model without pipeline changes.
EMBEDDING_MODEL=local-hashing
EMBEDDING_DIMENSION=256
EMBEDDING_BATCH_SIZE=64
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# --- Retrieval (Phase 4B) ---------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0

# --- LLM Analysis (Phase 5) -------------------------------------------------
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
