# Wazuh Server & Indexer Integration Configuration Template
# Copy relevant variables into your active `.env` file when connecting a remote Wazuh server.
#
# ARCHITECTURAL NOTE:
# Wazuh consists of:
# 1. Wazuh Indexer (port 9200): OpenSearch-compatible REST API storing `wazuh-alerts-*`.
#    This is the PREFERRED and most performant connector for querying alert telemetry.
# 2. Wazuh Manager (port 55000): Management REST API exposing `/alerts` and `/agents`.
#    Requires JWT authentication via `/security/user/authenticate`.
#
# Credentials must remain in environment variables only. Never commit credentials to git.

# ---------------------------------------------------------------------------
# Wazuh Mode Toggle
# ---------------------------------------------------------------------------
# "mock": Uses synthetic & curated demonstration alerts without reaching external networks.
# "real": Ingests live telemetry from remote Wazuh server specified below.
WAZUH_MODE=mock

# ---------------------------------------------------------------------------
# Connector Selection
# ---------------------------------------------------------------------------
# "indexer" (recommended for alerts) or "manager"
WAZUH_CONNECTOR_TYPE=indexer

# ---------------------------------------------------------------------------
# Option A: Wazuh Indexer (Port 9200 - Preferred for Alert Queries)
# ---------------------------------------------------------------------------
# URL to your remote Wazuh Indexer (OpenSearch) cluster
WAZUH_INDEXER_URL=https://wazuh-indexer.your-domain.internal:9200

# OpenSearch index pattern for Wazuh security alerts
WAZUH_INDEX_PATTERN=wazuh-alerts-*

# Read-only user created in Wazuh Indexer (OpenSearch security plugin)
# Best Practice: Create an internal user in OpenSearch Dashboard with read-only
# permissions mapped strictly to `wazuh-alerts-*`.
WAZUH_INDEXER_USERNAME=soc_reader
WAZUH_INDEXER_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# TLS / Certificate verification:
# Set to True for production. If using a custom enterprise CA or self-signed cert from Wazuh,
# provide the path to the root CA bundle (e.g. root-ca.pem).
WAZUH_VERIFY_SSL=True
WAZUH_CA_BUNDLE=/etc/ssl/certs/wazuh-root-ca.pem

# ---------------------------------------------------------------------------
# Option B: Wazuh Manager REST API (Port 55000 - Optional / Management)
# ---------------------------------------------------------------------------
# Used if WAZUH_CONNECTOR_TYPE=manager
WAZUH_BASE_URL=https://wazuh-manager.your-domain.internal:55000
WAZUH_USERNAME=soc_api_user
WAZUH_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ---------------------------------------------------------------------------
# Default UI Data Source
# ---------------------------------------------------------------------------
# "demo" | "live_wazuh" | "dataset_replay"
DEFAULT_DATA_SOURCE=demo
